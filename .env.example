# ---- Database: Turso (free tier: https://turso.tech) ----
# Leave both empty in development: the app then uses ./local.db, a SQLite file, with no account.
# For production, create a database and set its URL and a token in your host's environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Public address of the app (required in production for password-reset links) ----
# e.g. https://umunity.example.edu.ph
APP_URL=

# ---- Password-reset email via Resend (free tier: https://resend.com) ----
# Without these, development shows the reset link on screen and in the server log;
# production can't send reset emails.
RESEND_API_KEY=
RESET_EMAIL_FROM=

# ---- Demo accounts ----
# The six demo accounts (passwords are printed on the sign-in page) exist only in development.
# Set to true ONLY for a throwaway classroom demo; never on a real deployment.
ENABLE_DEMO_ACCOUNTS=
